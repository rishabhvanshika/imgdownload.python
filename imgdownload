app = Flask(__name__)

# Enhanced Instagram image fetcher
def get_instagram_image_url(post_url):
    try:
        headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36',
            'Accept-Language': 'en-US,en;q=0.9'
        }
        
        response = requests.get(post_url, headers=headers, timeout=10)
        soup = BeautifulSoup(response.text, 'html.parser')
        
        # Method 1: Check Open Graph meta tags
        meta_tags = soup.find_all('meta', property='og:image')
        if meta_tags:
            return meta_tags[0]['content']
        
        # Method 2: Check Twitter card meta tags
        meta_tags = soup.find_all('meta', attrs={'name': 'twitter:image'})
        if meta_tags:
            return meta_tags[0]['content']
        
        # Method 3: Parse JavaScript data
        script_tags = soup.find_all('script', type='text/javascript')
        for script in script_tags:
            if 'window._sharedData' in script.text:
                shared_data = script.text.split('window._sharedData = ')[1].split(';</script>')[0]
                json_match = re.search(r'"display_url":"([^"]+)"', shared_data)
                if json_match:
                    return json_match.group(1).replace(r'\u0026', '&')
        
        # Method 4: Look for video content
        video_tag = soup.find('meta', property='og:video')
        if video_tag:
            return video_tag['content']
        
        return None
    except Exception as e:
        print(f"Error fetching image: {str(e)}")
        return None

