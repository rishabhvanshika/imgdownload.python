@app.route('/download', methods=['POST'])
def download():
    post_url = request.form.get('url')
    if not post_url:
        return jsonify({'error': 'Please enter a URL'}), 400
    
    if 'instagram.com' not in post_url:
        return jsonify({'error': 'Please enter a valid Instagram URL'}), 400
    
    image_url = get_instagram_image_url(post_url)
    if not image_url:
        return jsonify({'error': 'Could not fetch image from this URL. Try another post.'}), 400
    
    return jsonify({
        'success': True,
        'image_url': image_url,
        'filename': 'instagram_image.jpg'
    })

