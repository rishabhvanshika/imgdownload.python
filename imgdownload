                downloadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
                
                // Send request to backend
                fetch('/download', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `url=${encodeURIComponent(url)}`
                })
